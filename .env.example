# ============================================================
# Dorm Party（宿舍派对）环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# -------------------- 数据库配置 --------------------
DB_PASSWORD=root123456
DB_DATABASE=dorm_party

# -------------------- Redis 配置 --------------------
REDIS_PASSWORD=

# -------------------- DeepSeek AI 配置 --------------------
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.8

# -------------------- 前端环境变量（构建时注入） --------------------
# Docker 部署时设为 Nginx 对外地址，本地开发设为 http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost
